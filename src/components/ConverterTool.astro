---
import Actions from './Actions.astro';
import Dropzone from './Dropzone.astro';
import Options from './Options.astro';
import Player from './Player.astro';
import Queue from './Queue.astro';
import ScriptAudio from './ScriptAudio.astro';
import ScriptPdf from './ScriptPdf.astro';
import ScriptVideo from './ScriptVideo.astro';
import VideoOptions from './VideoOptions.astro';
import PdfModes from './PdfModes.astro';
import PdfOptions from './PdfOptions.astro';
import { ui } from '../i18n/ui.js';

const { lang, title, tool = 'audio', preset, presetQuality } = Astro.props;
---

<div class="converter" data-tool={tool}>
  <h1 class="title enter">{title}</h1>
  <p class="load-error" id="loadError" role="alert" hidden>{ui[lang].loadError}</p>
  {tool === 'pdf' && <PdfModes lang={lang} preset={preset} />}
  <Dropzone lang={lang} tool={tool} />
  <Queue lang={lang} />
  {tool === 'audio' && <Options lang={lang} preset={preset} />}
  {tool === 'video' && <VideoOptions lang={lang} preset={preset} presetQuality={presetQuality} />}
  {tool === 'pdf' && <PdfOptions lang={lang} />}
  <Actions lang={lang}>
    <button type="button" class="btn" id="btnAgain" hidden>{tool === 'pdf' ? ui[lang].pdfOptions.again : ui[lang].options.again}</button>
  </Actions>
</div>

{tool !== 'pdf' && <Player lang={lang} tool={tool} />}
<div class="toast" id="toast" role="status" aria-live="polite"></div>

{tool === 'audio' && <ScriptAudio />}
{tool === 'video' && <ScriptVideo />}
{tool === 'pdf' && <ScriptPdf />}
<script is:inline src="/js/load-check.js"></script>

<style>
  .load-error {
    margin-top: 16px;
    color: var(--warning);
  }

  .converter {
    padding-top: 32px;
  }

  .title {
    transition: font-size 0.35s var(--ease), color 0.25s;
  }

  /* Con archivos, el título deja de ser el protagonista. */
  :global(body[data-state='queue']) .title,
  :global(body[data-state='done']) .title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    max-width: min(420px, calc(100vw - 32px));
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-raised);
    font-size: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--rise));
    transition: opacity 0.2s, transform 0.25s var(--ease);
  }

  .toast:global(.show) {
    opacity: 1;
    transform: none;
  }

  .toast:global(.warning),
  .toast:global(.error) {
    border-color: var(--warning);
  }

  :global(body:has(.player:not([hidden]))) .toast {
    bottom: 100px;
  }

  @media (max-width: 559px) {
    .converter {
      padding-top: 16px;
    }

    :global(body:has(.player:not([hidden]))) .toast {
      bottom: 160px;
    }
  }
</style>
