---
import Dropzone from './Dropzone.astro';
import Options from './Options.astro';
import Player from './Player.astro';
import Queue from './Queue.astro';

const { lang, title, preset } = Astro.props;
---

<div class="converter">
  <h1 class="title enter">{title}</h1>
  <Dropzone lang={lang} />
  <Queue lang={lang} />
  <Options lang={lang} preset={preset} />
</div>

<Player lang={lang} />
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script is:inline defer src="/js/lame.min.js"></script>
<script src="../scripts/app.js"></script>

<style>
  .converter {
    padding-top: 32px;
  }

  .title {
    transition: font-size 0.35s var(--ease), color 0.25s;
  }

  /* Con archivos, el título deja de ser el protagonista. */
  :global(body[data-state='queue']) .title,
  :global(body[data-state='done']) .title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    max-width: min(420px, calc(100vw - 32px));
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-raised);
    font-size: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--rise));
    transition: opacity 0.2s, transform 0.25s var(--ease);
  }

  .toast:global(.show) {
    opacity: 1;
    transform: none;
  }

  .toast:global(.warning),
  .toast:global(.error) {
    border-color: var(--warning);
  }

  :global(body:has(.player:not([hidden]))) .toast {
    bottom: 100px;
  }

  @media (max-width: 559px) {
    .converter {
      padding-top: 16px;
    }

    :global(body:has(.player:not([hidden]))) .toast {
      bottom: 160px;
    }
  }
</style>
