---
import { ui } from '../i18n/ui.js';

const { lang = 'es', preset } = Astro.props;
const text = ui[lang].options;
const initialFormat = preset ?? 'mp3';
const formats = ['wav', 'mp3', 'ogg', 'aac'].map((value) => ({
  value,
  name: value.toUpperCase(),
  detail: text.formats[value],
}));
const qualities = [128, 256, 320];
const rates = [8000, 11025, 16000, 22050, 44100, 48000, 96000];
---

<section class="options card enter enter-1" id="optionsSection" aria-labelledby="formatTitle" hidden>
  <h2 class="section-title" id="formatTitle" tabindex="-1">{text.convertTo}</h2>

  <div class="seg seg-four formats" role="radiogroup" aria-labelledby="formatTitle" data-preset={preset}>
    <span class="seg-slider" aria-hidden="true"></span>
    {
      formats.map((format) => (
        <label>
          <input class="sr-only" type="radio" name="format" value={format.value} checked={format.value === initialFormat} />
          <span class="choice-box">
            <span class="choice-name">{format.name}</span>
            <span class="choice-detail" data-detail>{format.detail}</span>
          </span>
        </label>
      ))
    }
  </div>

  <div class="row-field" id="qualityField">
    <span class="field-label" id="qualityLabel">{text.quality}</span>
    <div class="seg seg-quiet seg-options quality-options" role="radiogroup" aria-labelledby="qualityLabel">
      <span class="seg-slider" aria-hidden="true"></span>
      {
        qualities.map((quality) => (
          <label>
            <input class="sr-only" type="radio" name="quality" value={quality} checked={quality === 256} />
            <span class="option-box">{quality} kbps</span>
          </label>
        ))
      }
    </div>
  </div>

  <p class="note" id="formatNote" hidden>{text.note}</p>
  <p class="note">{text.dropped}</p>

  <details class="more">
    <summary>{text.more}</summary>
    <div class="more-grid">
      <div class="field">
        <label class="field-label" for="channels">{text.channels}</label>
        <select id="channels">
          <option value="1">{text.mono}</option>
          <option value="2" selected>{text.stereo}</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="normalize">{text.normalize}</label>
        <select id="normalize">
          <option value="0" selected>{text.no}</option>
          <option value="1">{text.yes}</option>
        </select>
      </div>
      <div class="field">
        <label class="field-label" for="sampleRate">{text.sampleRate}</label>
        <select id="sampleRate">
          {rates.map((rate) => <option value={rate} selected={rate === 48000}>{rate.toLocaleString(lang)} Hz</option>)}
        </select>
      </div>
      <label class="check">
        <input type="checkbox" id="keepSampleRate" checked />
        {text.keepRate}
      </label>
    </div>
  </details>
</section>

<style>
  .quality-options {
    --cols: 3;
  }
</style>
