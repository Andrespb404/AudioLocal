---
import { ui } from '../i18n/ui.js';

const { lang = 'es', preset = 'to-images' } = Astro.props;
const text = ui[lang].pdfOptions;
const modes = ['to-images', 'from-images', 'merge', 'split', 'organize', 'compress'];
---

<div class="seg seg-six pdf-modes enter enter-1" id="pdfModes" role="radiogroup" aria-label={text.modesLabel}>
  <span class="seg-slider" aria-hidden="true"></span>
  {
    modes.map((mode) => (
      <label>
        <input class="sr-only" type="radio" name="pdfMode" value={mode} checked={mode === preset} />
        <span class="choice-box">
          <span class="choice-name">{text.modes[mode].name}</span>
          <span class="choice-detail">{text.modes[mode].detail}</span>
        </span>
      </label>
    ))
  }
</div>

<style>
  /* Seis modos: 3 columnas por 2 filas (2 por 3 en el celular). El indicador rojo sigue a la opción elegida. */
  .seg-six {
    --cols: 3;
    --rows: 2;
  }

  .seg-six:has(label:nth-of-type(2) input:checked) { --col: 1; --row: 0; }
  .seg-six:has(label:nth-of-type(3) input:checked) { --col: 2; --row: 0; }
  .seg-six:has(label:nth-of-type(4) input:checked) { --col: 0; --row: 1; }
  .seg-six:has(label:nth-of-type(5) input:checked) { --col: 1; --row: 1; }
  .seg-six:has(label:nth-of-type(6) input:checked) { --col: 2; --row: 1; }

  .pdf-modes {
    margin-top: 32px;
  }

  .pdf-modes :global(.choice-name) {
    font-size: 1rem;
  }

  /* La tarjeta blanca ya no necesita tanta separación con el selector encima. */
  .pdf-modes + :global(.dropzone) {
    margin-top: 16px;
  }

  @media (max-width: 559px) {
    .pdf-modes {
      margin-top: 24px;
    }

    .seg-six { --cols: 2; --rows: 3; }
    .seg-six:has(label:nth-of-type(2) input:checked) { --col: 1; --row: 0; }
    .seg-six:has(label:nth-of-type(3) input:checked) { --col: 0; --row: 1; }
    .seg-six:has(label:nth-of-type(4) input:checked) { --col: 1; --row: 1; }
    .seg-six:has(label:nth-of-type(5) input:checked) { --col: 0; --row: 2; }
    .seg-six:has(label:nth-of-type(6) input:checked) { --col: 1; --row: 2; }
  }
</style>
