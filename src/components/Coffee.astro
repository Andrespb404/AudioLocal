---
import { ui } from '../i18n/ui.js';

const { lang = 'es' } = Astro.props;
const text = ui[lang];
---

<aside class="coffee card enter enter-3" aria-labelledby="coffeeTitle">
  <div>
    <h2 class="coffee-title" id="coffeeTitle">{text.coffeeTitle}</h2>
    <p class="coffee-text">{text.coffeeText}</p>
  </div>
  <a class="btn coffee-btn" href="https://ko-fi.com/audiolocal" target="_blank" rel="noopener">
    {text.coffee}
    <span class="sr-only">{text.newTab}</span>
  </a>
</aside>

<style>
  .coffee {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 16px;
  }

  .coffee-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .coffee-text {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .coffee-btn {
    flex: none;
    border-color: var(--coffee);
    background: var(--coffee);
    color: var(--coffee-ink);
    font-weight: 600;
    transition: background-color 0.15s, border-color 0.15s, transform 0.2s var(--ease);
  }

  .coffee-btn:hover {
    border-color: var(--coffee-hover);
    background: var(--coffee-hover);
    transform: translateY(var(--lift));
  }

  .coffee-btn:active {
    transform: scale(var(--press));
  }

  /* Al terminar de convertir, la card vuelve a entrar: es el mejor momento para verla. */
  :global(body[data-state='done']) .coffee {
    animation: rise-again 0.5s var(--ease) 0.2s backwards;
  }

  @media (max-width: 559px) {
    .coffee {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
