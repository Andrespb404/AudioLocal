---
interface Props {
  active: string;
}
const { active } = Astro.props;

const links = [
  { id: 'convert', href: '/', label: 'Convertir' },
  { id: 'about', href: '/about.html', label: 'Acerca de' },
  { id: 'privacy', href: '/privacy.html', label: 'Privacidad' },
  { id: 'terms', href: '/terms.html', label: 'Términos' },
];
---

<header class="site-header">
  <a href="/" class="brand" aria-label="AudioLocal, inicio">
    <svg viewBox="0 0 256 256" aria-hidden="true"><path fill-rule="evenodd" d="M118.10 28.90A14 14 0 0 1 137.90 28.90L223.90 114.90A14 14 0 0 1 228.00 124.80L228.00 211.00A20 20 0 0 1 208.00 231.00L48.00 231.00A20 20 0 0 1 28.00 211.00L28.00 124.80A14 14 0 0 1 32.10 114.90ZM80 135h0a14 14 0 0 1 14 14v20a14 14 0 0 1 -14 14h0a14 14 0 0 1 -14 -14v-20a14 14 0 0 1 14 -14ZM128 107h0a14 14 0 0 1 14 14v76a14 14 0 0 1 -14 14h0a14 14 0 0 1 -14 -14v-76a14 14 0 0 1 14 -14ZM176 135h0a14 14 0 0 1 14 14v20a14 14 0 0 1 -14 14h0a14 14 0 0 1 -14 -14v-20a14 14 0 0 1 14 -14Z"></path></svg>
    AudioLocal
  </a>
  <nav aria-label="Principal">
    {
      links.map((link) => (
        <a href={link.href} class:list={{ active: active === link.id }} aria-current={active === link.id ? 'page' : undefined}>
          {link.label}
          {active === link.id && <span class="nav-line" />}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    padding: 20px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--text);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand svg {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
  }

  /* Línea que crece al pasar el mouse. */
  nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 2px;
    background: var(--line-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  nav a:hover {
    color: var(--text);
  }

  nav a:hover:not(.active)::after {
    transform: scaleX(1);
  }

  nav a.active {
    color: var(--red-text);
  }

  /* Elemento real: al cambiar de página, esta línea viaja hasta el nuevo enlace. */
  .nav-line {
    position: absolute;
    right: 0;
    bottom: 4px;
    left: 0;
    height: 2px;
    background: var(--red-text);
    view-transition-name: nav-line;
  }

  @media (max-width: 559px) {
    .site-header {
      padding: 12px 0;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    nav a {
      font-size: 0.875rem;
    }
  }
</style>
