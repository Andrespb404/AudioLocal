---
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { ui } from '../i18n/ui.js';

interface Props {
  title: string;
  description: string;
  path: string;
  alternate: string;
  lang?: 'es' | 'en';
  active: 'audio' | 'video' | 'pdf' | 'about' | 'privacy' | 'terms';
  ogTitle?: string;
  ogDescription?: string;
  ogImageAlt: string;
  twitterTitle?: string;
  twitterDescription?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  alternate,
  lang = 'es',
  active,
  ogTitle = title,
  ogDescription = description,
  ogImageAlt,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  jsonLd,
  noindex = false,
} = Astro.props;

const text = ui[lang];
const canonical = new URL(path, Astro.site).href;
const alternateUrl = new URL(alternate, Astro.site).href;
const esUrl = lang === 'es' ? canonical : alternateUrl;
const enUrl = lang === 'en' ? canonical : alternateUrl;
const ogImage = new URL(lang === 'en' ? '/assets/audiolocal_og_en.png' : '/assets/audiolocal_og.png', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="index,follow" />
    <meta name="description" content={description} />
    <meta name="author" content="AudioLocal" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0c0c0d" />

    <meta property="og:locale" content={text.ogLocale} />
    <meta property="og:locale:alternate" content={ui[text.otherLanguageCode].ogLocale} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" href={esUrl} hreflang="es" />
    <link rel="alternate" href={enUrl} hreflang="en" />
    <link rel="alternate" href={enUrl} hreflang="x-default" />
    <link rel="icon" href="/assets/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href={lang === 'en' ? '/manifest.en.webmanifest' : '/manifest.webmanifest'} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <div class="page">
      <Header active={active} lang={lang} alternate={alternate} />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-links">
          {text.footerNav.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href="https://ko-fi.com/audiolocal" target="_blank" rel="noopener">{text.coffee}</a>
        </div>
        <p>© 2026 AudioLocal · <span id="offlineStatus" role="status">{text.processedHere}</span></p>
      </footer>
    </div>
    <script src="../scripts/pwa.js"></script>
  </body>
</html>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 24px;
    margin-top: 72px;
    padding: 16px 0 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }
</style>
