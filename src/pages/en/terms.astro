---
import Base from '../../layouts/Base.astro';

const sections = [
  { title: '1. Acceptance of the Terms', text: 'By accessing and using AudioLocal, you accept these Terms and Conditions. If you do not agree, please do not use the service.' },
  { title: '2. Description of the Service', text: 'AudioLocal is a web tool for converting audio files directly in the user\'s browser. All processing is done locally.' },
  {
    title: '3. Use of the Service',
    items: [
      'You may not use the service for illegal purposes or in ways that infringe the rights of others.',
      'You are solely responsible for the content of the files you process.',
      'You may not attempt to extract, modify or reverse engineer the converter\'s source code.',
    ],
  },
  { title: '4. Intellectual Property', text: 'All content, design and code of AudioLocal belong to its developers. You are granted a limited, revocable and non-exclusive permission for personal use.' },
  {
    title: '5. Limitation of Liability',
    text: 'The service is provided "as is" without warranties of any kind. We are not responsible for:',
    items: ['Loss or corruption of files', 'Damages arising from use of the service', 'Compatibility issues with devices or software'],
  },
  { title: '6. Donations', text: 'The site accepts voluntary donations through Ko-fi. Donations are optional and do not affect access to the service.' },
  { title: '7. Changes', text: 'We reserve the right to change these terms at any time. Continued use of the site after changes means you accept the new terms.' },
  { title: '8. Governing Law', text: 'These terms are governed by the laws of the Republic of Colombia (or the operator\'s country of residence).' },
];
---

<Base
  title="AudioLocal | Terms and Conditions"
  description="Terms and Conditions for using AudioLocal, the local audio converter that runs in your browser."
  path="/en/terms.html"
  alternate="/terms.html"
  lang="en"
  active="terms"
  ogDescription="Terms of use for the local audio converter"
  ogImageAlt="AudioLocal terms, a local audio conversion service"
>
  <article class="doc prose">
    <h1 class="title">Terms and Conditions</h1>
    <p class="lead">Last updated: May 20, 2026</p>

    {
      sections.map((section) => (
        <section class="doc-section">
          <h2>{section.title}</h2>
          {section.text && <p>{section.text}</p>}
          {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
        </section>
      ))
    }

    <section class="doc-section">
      <h2>Contact</h2>
      <p>Any questions about these terms can be sent to: <a href="mailto:audiolocal.app@gmail.com">audiolocal.app@gmail.com</a></p>
    </section>
  </article>
</Base>
