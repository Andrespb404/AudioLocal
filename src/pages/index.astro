---
import Base from '../layouts/Base.astro';
import Coffee from '../components/Coffee.astro';
import Dropzone from '../components/Dropzone.astro';
import Options from '../components/Options.astro';
import Player from '../components/Player.astro';
import Queue from '../components/Queue.astro';

const features = [
  { title: 'Privado', text: 'Tus archivos se procesan aquí, en tu equipo. Nunca llegan a un servidor.' },
  { title: 'Sin conexión', text: 'Después de la primera visita también funciona en modo avión.' },
  { title: 'A tu medida', text: 'Elige formato, calidad, canales y frecuencia para todo el lote.' },
];

const faq = [
  { question: '¿Es realmente seguro usar AudioLocal?', answer: 'Sí. Todo el procesamiento ocurre en tu dispositivo. No subimos ni almacenamos ningún archivo.' },
  { question: '¿Funciona en el celular?', answer: 'Sí, funciona en móviles Android e iOS a través del navegador.' },
  { question: '¿Hay límites de tamaño de archivo?', answer: 'Cada archivo puede pesar hasta 150 MB y durar hasta 20 minutos. No hay límite de conversiones.' },
  { question: '¿Funciona sin internet?', answer: 'Sí. Después de la primera visita, la aplicación queda guardada en tu navegador y puedes convertir sin conexión.' },
];
---

<Base
  title="AudioLocal | Convertidor de audio local y privado"
  description="AudioLocal es un convertidor de audio local que convierte MP3, WAV, OGG y AAC directamente en tu navegador. Sin subir archivos, sin registro y con privacidad total."
  path="/"
  active="convert"
  keywords="convertidor de audio, convertidor de audio local, convertir audio, mp3 a wav, ogg a mp3"
  ogDescription="AudioLocal es un convertidor de audio en el navegador que procesa MP3, WAV, OGG y AAC sin subir archivos. Privacidad total y descarga instantánea."
  ogImageAlt="Logo de AudioLocal, convertidor de audio local"
  twitterDescription="AudioLocal es un convertidor de audio que transforma MP3, WAV, OGG y AAC en el navegador. Sin servidores, sin registro y con privacidad total."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'AudioLocal',
    url: 'https://audiolocal.app/',
    description: 'Convertidor de audio local que procesa MP3, WAV, OGG y AAC directamente en el navegador sin subir archivos.',
  }}
>
  <div class="converter">
    <h1 class="title enter">Convertidor de audio que no sube tus archivos</h1>
    <Dropzone />
    <Queue />
    <Options />
  </div>

  <Coffee />

  <section class="features" aria-label="Características">
    {
      features.map((feature) => (
        <div class="card reveal">
          <h2 class="feature-title">{feature.title}</h2>
          <p class="feature-text">{feature.text}</p>
        </div>
      ))
    }
  </section>

  <section class="card prose reveal seo">
    <h2>¿Cómo convertir audio gratis y sin perder calidad?</h2>
    <p>AudioLocal es un convertidor que trabaja completamente en tu navegador con la Web Audio API. Esto significa que tu privacidad está protegida y no hay esperas de subida.</p>
    <ul>
      <li>Convierte MP3, WAV, OGG o AAC localmente sin subir tus archivos a ningún servidor.</li>
      <li>Sin registro, sin cuentas y sin transferencia de datos personales.</li>
      <li>Ideal para podcasters, creadores y usuarios que buscan una herramienta de audio rápida y privada.</li>
    </ul>

    <h3>¿Por qué convertir a WAV?</h3>
    <p>El formato WAV es ideal para edición profesional, ya que es lossless (sin pérdida de calidad). Perfecto para productores, podcasters y músicos.</p>
  </section>

  <section class="faq" aria-labelledby="faqTitle">
    <h2 class="section-title reveal" id="faqTitle">Preguntas frecuentes</h2>
    {
      faq.map((item) => (
        <details class="faq-item reveal">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </section>

  <Player />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script is:inline defer src="/js/lame.min.js"></script>
  <script src="../scripts/app.js"></script>
</Base>

<style>
  .converter {
    padding-top: 32px;
  }

  .title {
    transition: font-size 0.35s var(--ease), color 0.25s;
  }

  /* Con archivos, el título deja de ser el protagonista. */
  :global(body[data-state='queue']) .title,
  :global(body[data-state='done']) .title {
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 16px;
  }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .feature-text {
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .seo {
    margin-top: 16px;
  }

  .faq {
    display: grid;
    gap: 8px;
    margin-top: 40px;
  }

  .faq .section-title {
    margin-bottom: 8px;
  }

  .faq-item {
    padding: 0 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .faq-item:hover {
    border-color: var(--line-strong);
  }

  summary {
    padding: 8px 0;
    font-weight: 500;
  }

  .faq-item p {
    padding-bottom: 16px;
    color: #cfcfce;
  }

  .toast {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    max-width: min(420px, calc(100vw - 32px));
    padding: 12px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface-raised);
    font-size: 0.875rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(var(--rise));
    transition: opacity 0.2s, transform 0.25s var(--ease);
  }

  .toast:global(.show) {
    opacity: 1;
    transform: none;
  }

  .toast:global(.warning),
  .toast:global(.error) {
    border-color: var(--warning);
  }

  :global(body:has(.player:not([hidden]))) .toast {
    bottom: 100px;
  }

  @media (max-width: 559px) {
    .converter {
      padding-top: 16px;
    }

    .features {
      grid-template-columns: minmax(0, 1fr);
    }

    :global(body:has(.player:not([hidden]))) .toast {
      bottom: 160px;
    }
  }
</style>
