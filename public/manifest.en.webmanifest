{
  "name": "AudioLocal",
  "short_name": "AudioLocal",
  "description": "Convert audio, video and PDF for free, with no sign-up and no ads.",
  "lang": "en",
  "start_url": "/en.html",
  "display": "standalone",
  "background_color": "#0c0c0d",
